# ==============================================================================
# Midaz Plugin: Open Finance Sync (.env.example)
# ==============================================================================

# Application Environment
ENV_NAME=development
LOG_LEVEL=info
SERVER_ADDRESS=0.0.0.0:8085
PLUGIN_HOST=http://localhost:8085

# Provider Selection: 'openfinance' (Direct Brasil Open Finance) or 'pluggy' (Aggregator)
PROVIDER=openfinance

# Synchronization Settings
SYNC_INTERVAL_MINUTES=60
LOOKBACK_WINDOW_HOURS=24

# Midaz Core Connection
MIDAZ_ONBOARDING_URL=http://localhost:3000
MIDAZ_TRANSACTION_URL=http://localhost:3001
MIDAZ_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
MIDAZ_LEDGER_ID=00000000-0000-0000-0000-000000000000
MIDAZ_CLEARING_ACCOUNT_ALIAS=@external/BRL:openfinance
MIDAZ_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# Direct Open Finance Brasil Settings (Used when PROVIDER=openfinance)
# ------------------------------------------------------------------------------
OPENFINANCE_ENVIRONMENT=sandbox
OPENFINANCE_DIRECTORY_URL=https://matls-auth.sandbox.directory.openbankingbrasil.org.br
OPENFINANCE_CLIENT_ID=
OPENFINANCE_TRANSPORT_CERT_PATH=./config/certs/transport.pem
OPENFINANCE_TRANSPORT_KEY_PATH=./config/certs/transport.key
OPENFINANCE_SIGNING_CERT_PATH=./config/certs/signing.pem
OPENFINANCE_SIGNING_KEY_PATH=./config/certs/signing.key

# ------------------------------------------------------------------------------
# Pluggy Aggregator Settings (Used when PROVIDER=pluggy)
# ------------------------------------------------------------------------------
PLUGGY_BASE_URL=https://api.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# ==============================================================================
# Midaz Plugin: Open Finance - Direct Brasil (BACEN) Environment Configuration
# ==============================================================================
# Use this configuration file when connecting directly to Brazilian banks via
# the Open Finance Brasil regulated directory and FAPI 1.0 Advanced mTLS.
# Requires valid ICP-Brasil X.509 cryptographic certificates.
#
# To use:
#   cp examples/.env.openfinance.example .env
# ==============================================================================

# Application Runtime Settings
ENV_NAME=development
LOG_LEVEL=info
SERVER_ADDRESS=0.0.0.0:8085
PLUGIN_HOST=http://localhost:8085

# Active Banking Provider ('openfinance' or 'pluggy')
PROVIDER=openfinance

# Synchronization & Polling Settings
SYNC_INTERVAL_MINUTES=60
LOOKBACK_WINDOW_HOURS=24

# ==============================================================================
# PostgreSQL Database Settings
# ==============================================================================
# Priority 1: Full connection URI (e.g. AWS RDS, Supabase, Neon, Cloud SQL)
# DATABASE_URL=postgres://midaz:midaz_secure_password@localhost:5432/plugin_openfinance?sslmode=disable
# DB_URI=postgres://midaz:midaz_secure_password@localhost:5432/plugin_openfinance?sslmode=disable

# Priority 2: Discrete parameters (used if DATABASE_URL/DB_URI is unset)
DB_HOST=localhost
DB_PORT=5432
DB_USER=midaz
DB_PASSWORD=midaz_secure_password
DB_NAME=plugin_openfinance
DB_SSLMODE=disable

# Database Migration Governance
# When true, automatically applies embedded migrations on startup using PostgreSQL advisory locks.
DB_AUTO_MIGRATE=true

# ==============================================================================
# Midaz Ledger Core Settings
# ==============================================================================
MIDAZ_ONBOARDING_URL=http://localhost:3000
MIDAZ_TRANSACTION_URL=http://localhost:3001
MIDAZ_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
MIDAZ_LEDGER_ID=00000000-0000-0000-0000-000000000000
MIDAZ_CLEARING_ACCOUNT_ALIAS=@external/BRL:openfinance
MIDAZ_AUTH_TOKEN=

# ==============================================================================
# Open Finance Brasil (BACEN FAPI 1.0 Advanced) Credentials & Certificates
# ==============================================================================
# Environment: 'sandbox' or 'production'
OPENFINANCE_ENVIRONMENT=sandbox

# Open Finance Directory Discovery URL
# Sandbox:    https://matls-auth.sandbox.directory.openbankingbrasil.org.br
# Production: https://matls-auth.directory.openbankingbrasil.org.br
OPENFINANCE_DIRECTORY_URL=https://matls-auth.sandbox.directory.openbankingbrasil.org.br

# Your Participant Client ID registered in the Open Finance Directory
OPENFINANCE_CLIENT_ID=your_participant_client_id_here

# ICP-Brasil Transport Certificates (used for mutual TLS 1.2/1.3 handshakes)
OPENFINANCE_TRANSPORT_CERT_PATH=./config/certs/transport.pem
OPENFINANCE_TRANSPORT_KEY_PATH=./config/certs/transport.key

# ICP-Brasil Signing Certificates (used for JWS PS256 payload signing)
OPENFINANCE_SIGNING_CERT_PATH=./config/certs/signing.pem
OPENFINANCE_SIGNING_KEY_PATH=./config/certs/signing.key

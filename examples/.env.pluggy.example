# ==============================================================================
# Midaz Plugin: Open Finance - Pluggy Aggregator Environment Configuration
# ==============================================================================
# Use this configuration file when integrating with Pluggy (https://pluggy.ai).
# This is the recommended provider for fast onboarding without requiring BACEN
# ICP-Brasil cryptographic certificates.
#
# To use:
#   cp examples/.env.pluggy.example .env
# ==============================================================================

# Application Runtime Settings
ENV_NAME=development
LOG_LEVEL=info
SERVER_ADDRESS=0.0.0.0:8085
PLUGIN_HOST=http://localhost:8085

# Active Banking Provider ('pluggy' or 'openfinance')
PROVIDER=pluggy

# Synchronization & Polling Settings (Fallback background worker)
# Interval in minutes between periodic sync checks
SYNC_INTERVAL_MINUTES=60
# Lookback window in hours for statement polling (default: 24h)
LOOKBACK_WINDOW_HOURS=24

# ==============================================================================
# PostgreSQL Database Settings
# ==============================================================================
# The plugin stores bank connections, idempotency hashes, and checkpoints in PostgreSQL.
#
# Priority 1: Full connection URI (e.g. AWS RDS, Supabase, Neon, Cloud SQL)
# If DATABASE_URL or DB_URI is defined, it takes absolute precedence over discrete params.
# DATABASE_URL=postgres://midaz:midaz_secure_password@localhost:5432/plugin_openfinance?sslmode=disable
# DB_URI=postgres://midaz:midaz_secure_password@localhost:5432/plugin_openfinance?sslmode=disable

# Priority 2: Discrete parameters (used if DATABASE_URL/DB_URI is unset)
DB_HOST=localhost
DB_PORT=5432
DB_USER=midaz
DB_PASSWORD=midaz_secure_password
DB_NAME=plugin_openfinance
DB_SSLMODE=disable

# Database Migration Governance
# When true, automatically applies embedded migrations on startup using PostgreSQL advisory locks.
DB_AUTO_MIGRATE=true

# ==============================================================================
# Midaz Ledger Core Settings
# ==============================================================================
# Base URLs for Midaz Onboarding and Transaction REST APIs
MIDAZ_ONBOARDING_URL=http://localhost:3000
MIDAZ_TRANSACTION_URL=http://localhost:3001

# The Midaz Organization and Ledger UUIDs where accounts reside
MIDAZ_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
MIDAZ_LEDGER_ID=00000000-0000-0000-0000-000000000000

# Dedicated external clearing account used to balance bank inflows/outflows in double-entry.
# Must be of type "external" in Midaz. Automatically verified/created on startup.
MIDAZ_CLEARING_ACCOUNT_ALIAS=@external/BRL:openfinance

# Optional: Bearer token if Midaz API authentication is enabled
MIDAZ_AUTH_TOKEN=

# ==============================================================================
# Pluggy Aggregator Credentials
# ==============================================================================
# Obtained from your Pluggy Dashboard (https://dashboard.pluggy.ai)
PLUGGY_BASE_URL=https://api.pluggy.ai
PLUGGY_CLIENT_ID=your_pluggy_client_id_here
PLUGGY_CLIENT_SECRET=your_pluggy_client_secret_here

# Optional: Webhook secret configured in your Pluggy Webhook settings for HMAC verification
PLUGGY_WEBHOOK_SECRET=
